<Project>
    <!--
        The build settings of ThinkMeta.ConcurrentTasks for the ctOpus projects: they come from the API
        submodule of the Samples repository (..\..\ThinkMeta.ConcurrentTasks.API). Output in build\ next
        to ctOpus.slnx: build\<Configuration>\bin.
    -->
    <Import Project="$(MSBuildThisFileDirectory)..\..\ThinkMeta.ConcurrentTasks.API\ThinkMeta.SolutionFiles\ThinkMeta.Build.props" />
</Project>
