// Version resource of ctOpusLiveBench.exe

#include <winver.h>

#include "../Encoder/ctOpusVersion.h"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     CTOPUS_VERSION_MAJOR, CTOPUS_VERSION_MINOR, CTOPUS_VERSION_PATCH, CTOPUS_VERSION_BUILD
PRODUCTVERSION  CTOPUS_VERSION_MAJOR, CTOPUS_VERSION_MINOR, CTOPUS_VERSION_PATCH, CTOPUS_VERSION_BUILD
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
FILEFLAGS       VS_FF_DEBUG
#else
FILEFLAGS       0
#endif
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", CTOPUS_COMPANY
            VALUE "FileDescription", "ctOpusLiveBench - live encoding latency benchmark of ctOpus"
            VALUE "FileVersion", CTOPUS_VERSION_STRING
            VALUE "InternalName", "ctOpusLiveBench"
            VALUE "LegalCopyright", CTOPUS_COPYRIGHT "; Opus: Copyright (c) 2001-2024 Xiph.Org Foundation, Skype Limited, Octasic; BSD-3-Clause"
            VALUE "OriginalFilename", "ctOpusLiveBench.exe"
            VALUE "ProductName", "ctOpus"
            VALUE "ProductVersion", CTOPUS_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
