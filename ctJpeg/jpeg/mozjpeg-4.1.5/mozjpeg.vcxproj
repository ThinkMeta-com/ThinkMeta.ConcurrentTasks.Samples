<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildThisFileDirectory)..\jpeg.props" />
  <PropertyGroup Label="Globals">
    <VCProjectVersion>18.0</VCProjectVersion>
    <Keyword>Win32Proj</Keyword>
    <ProjectGuid>{4A504547-0001-4000-8000-000000000001}</ProjectGuid>
    <RootNamespace>mozjpeg</RootNamespace>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Label="Configuration">
    <ConfigurationType>StaticLibrary</ConfigurationType>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <Import Project="$(MSBuildThisFileDirectory)..\jpeg.settings.props" />
  <!-- Unmodified mozjpeg 4.1.5 libjpeg (bit oracle), x86_64 NASM SIMD enabled.
       msvc\jconfig.h, jconfigint.h, jversion.h = CMake-generated (VS 18, x64, WITH_SIMD=1).
       Source list matches the upstream CMake target jpeg-static (no arithmetic coding, no turbojpeg). -->
  <PropertyGroup>
    <TM_Nasm Condition="'$(TM_Nasm)' == ''">nasm.exe</TM_Nasm>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <AdditionalIncludeDirectories>$(ProjectDir)msvc;$(ProjectDir);%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <PreprocessorDefinitions>WIN32;_WINDOWS;_CRT_SECURE_NO_WARNINGS;_CRT_NONSTDC_NO_WARNINGS;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <TreatWarningAsError>false</TreatWarningAsError>
      <WarningLevel>Level3</WarningLevel>
    </ClCompile>
    <CustomBuild>
      <Message>NASM %(Filename)%(Extension)</Message>
      <Command>"$(TM_Nasm)" -fwin64 -DWIN64 -D__x86_64__ -I"$(ProjectDir)simd\nasm\\" -I"$(ProjectDir)simd\x86_64\\" "%(FullPath)" -o"$(IntDir)%(Filename).asm.obj"</Command>
      <Outputs>$(IntDir)%(Filename).asm.obj</Outputs>
      <AdditionalInputs>$(ProjectDir)simd\nasm\jsimdext.inc;$(ProjectDir)simd\nasm\jsimdcfg.inc;$(ProjectDir)simd\nasm\jdct.inc;$(ProjectDir)simd\nasm\jcolsamp.inc;%(AdditionalInputs)</AdditionalInputs>
      <LinkObjects>true</LinkObjects>
    </CustomBuild>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClInclude Include="msvc\jconfig.h" />
    <ClInclude Include="msvc\jconfigint.h" />
    <ClInclude Include="msvc\jversion.h" />
    <ClInclude Include="jchuff.h" />
    <ClInclude Include="jcmaster.h" />
    <ClInclude Include="jdct.h" />
    <ClInclude Include="jerror.h" />
    <ClInclude Include="jinclude.h" />
    <ClInclude Include="jmemsys.h" />
    <ClInclude Include="jmorecfg.h" />
    <ClInclude Include="jpegcomp.h" />
    <ClInclude Include="jpegint.h" />
    <ClInclude Include="jpeglib.h" />
    <ClInclude Include="jsimd.h" />
    <ClInclude Include="jsimddct.h" />
    <ClInclude Include="simd\jsimd.h" />
  </ItemGroup>
  <ItemGroup>
    <ClCompile Include="jcapimin.c" />
    <ClCompile Include="jcapistd.c" />
    <ClCompile Include="jccoefct.c" />
    <ClCompile Include="jccolor.c" />
    <ClCompile Include="jcdctmgr.c" />
    <ClCompile Include="jchuff.c" />
    <ClCompile Include="jcext.c" />
    <ClCompile Include="jcicc.c" />
    <ClCompile Include="jcinit.c" />
