<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <!--
        Shared by mozjpeg, cjpeg, libjpeg-turbo and cjpeg-turbo, imported after Microsoft.Cpp.props:
        the settings bin\cjpeg.exe and bin\cjpeg-turbo.exe were built with (x64, /O2, whole program
        optimization, the static C runtime, no /arch switch, the SIMD code assembled with NASM).
        Output in jpeg\build\<configuration>\bin.

        NASM: nasm.exe on the PATH, or msbuild /p:TM_Nasm=C:\path\to\nasm.exe (https://www.nasm.us).
    -->
    <PropertyGroup>
        <OutDir>$(MSBuildThisFileDirectory)build\$(Configuration)\bin\</OutDir>
        <IntDir>$(MSBuildThisFileDirectory)build\$(Configuration)\obj\$(MSBuildProjectName)\</IntDir>
    </PropertyGroup>
    <ItemDefinitionGroup>
        <ClCompile>
            <WarningLevel>Level3</WarningLevel>
            <SDLCheck>false</SDLCheck>
            <ConformanceMode>true</ConformanceMode>
            <MultiProcessorCompilation>true</MultiProcessorCompilation>
            <TreatWarningAsError>false</TreatWarningAsError>
        </ClCompile>
        <Link>
            <GenerateDebugInformation>true</GenerateDebugInformation>
        </Link>
    </ItemDefinitionGroup>
    <ItemDefinitionGroup Condition="'$(Configuration)' == 'Debug'">
        <ClCompile>
            <RuntimeLibrary>MultiThreadedDebug</RuntimeLibrary>
            <PreprocessorDefinitions>_DEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
        </ClCompile>
    </ItemDefinitionGroup>
    <ItemDefinitionGroup Condition="'$(Configuration)' == 'Release'">
        <ClCompile>
            <PreprocessorDefinitions>NDEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
            <FunctionLevelLinking>true</FunctionLevelLinking>
            <IntrinsicFunctions>true</IntrinsicFunctions>
            <OmitFramePointers>true</OmitFramePointers>
            <WholeProgramOptimization>true</WholeProgramOptimization>
            <RuntimeLibrary>MultiThreaded</RuntimeLibrary>
        </ClCompile>
        <Link>
            <EnableCOMDATFolding>true</EnableCOMDATFolding>
            <OptimizeReferences>true</OptimizeReferences>
            <LinkTimeCodeGeneration>UseLinkTimeCodeGeneration</LinkTimeCodeGeneration>
        </Link>
    </ItemDefinitionGroup>
</Project>
