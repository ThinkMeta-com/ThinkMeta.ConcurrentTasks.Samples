  <PropertyGroup Label="Globals">
    <VCProjectVersion>18.0</VCProjectVersion>
    <Keyword>Win32Proj</Keyword>
    <ProjectGuid>{4A504547-0001-4000-8000-000000000003}</ProjectGuid>
    <RootNamespace>turbojpeg</RootNamespace>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Label="Configuration">
    <ConfigurationType>StaticLibrary</ConfigurationType>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <Import Project="$(MSBuildThisFileDirectory)..\jpeg.settings.props" />
  <!-- Unmodified libjpeg-turbo 3.2.0 libjpeg (speed/size reference), x86_64 NASM SIMD enabled.
       msvc\jconfig.h, jconfigint.h, jversion.h = CMake-generated (VS 18, x64, WITH_SIMD=1).
       Source list matches the upstream CMake target jpeg-static (8/12/16-bit wrappers, arithmetic coding). -->
  <PropertyGroup>
    <TargetName>libjpeg-turbo</TargetName>
    <TM_Nasm Condition="'$(TM_Nasm)' == ''">nasm.exe</TM_Nasm>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <AdditionalIncludeDirectories>$(ProjectDir)msvc;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <PreprocessorDefinitions>WIN32;_WINDOWS;_CRT_SECURE_NO_WARNINGS;_CRT_NONSTDC_NO_WARNINGS;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <TreatWarningAsError>false</TreatWarningAsError>
      <WarningLevel>Level3</WarningLevel>
      <ObjectFileName>$(IntDir)%(RelativeDir)</ObjectFileName>
    </ClCompile>
    <CustomBuild>
      <Message>NASM %(Filename)%(Extension)</Message>
      <Command>"$(TM_Nasm)" -fwin64 -DWIN64 -D__x86_64__ -I"$(ProjectDir)simd\nasm\\" -I"$(ProjectDir)simd\x86_64\\" "%(FullPath)" -o"$(IntDir)%(Filename).asm.obj"</Command>
      <Outputs>$(IntDir)%(Filename).asm.obj</Outputs>
      <AdditionalInputs>$(ProjectDir)simd\nasm\jsimdext.inc;$(ProjectDir)simd\nasm\jsimdcfg.inc;$(ProjectDir)simd\nasm\jdct.inc;$(ProjectDir)simd\nasm\jcolsamp.inc;%(AdditionalInputs)</AdditionalInputs>
      <LinkObjects>true</LinkObjects>
    </CustomBuild>
  </ItemDefinitionGroup>
