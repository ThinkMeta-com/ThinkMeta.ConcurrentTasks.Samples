      <PreprocessorDefinitions>HWY_DISABLED_TARGETS=(HWY_AVX3|HWY_AVX3_DL|HWY_AVX3_SPR|HWY_AVX3_ZEN4|HWY_RVV|HWY_SSSE3|HWY_SVE|HWY_SVE_256|HWY_SVE2|HWY_SVE2_128);FJXL_ENABLE_AVX512=0;_CRT_SECURE_NO_WARNINGS;JXL_STATIC_DEFINE;JXL_CMS_STATIC_DEFINE;JXL_THREADS_STATIC_DEFINE;TOOLCHAIN_MISS_SYS_AUXV_H;TOOLCHAIN_MISS_ASM_HWCAP_H;HWY_STATIC_DEFINE;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ProjectReference Include="$(TM_LibjxlMsvcDir)libjxl-png.vcxproj">
