  <!-- Generated from the Visual Studio project of libjpeg-turbo 3.2.0:
       same sources, code settings as the CMake build of libjxl's dependencies.
       Unmodified libjpeg-turbo 3.2.0 libjpeg (speed/size reference), x86_64 NASM SIMD enabled.
       msvc\jconfig.h, jconfigint.h, jversion.h = CMake-generated (VS 18, x64, WITH_SIMD=1).
       Source list matches the upstream CMake target jpeg-static (8/12/16-bit wrappers, arithmetic coding). -->
  <PropertyGroup>
    <TargetName>libjxl-jpeg-turbo</TargetName>
    <TM_JpegConfigDefine Condition="'$(Configuration)'=='Release'">NDEBUG</TM_JpegConfigDefine>
    <TM_JpegConfigDefine Condition="'$(Configuration)'=='Debug'">_DEBUG</TM_JpegConfigDefine>
