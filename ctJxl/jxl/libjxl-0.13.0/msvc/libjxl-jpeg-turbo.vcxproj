      <EnableFiberSafeOptimizations>false</EnableFiberSafeOptimizations>
      <ConformanceMode>false</ConformanceMode>
      <LanguageStandard_C>Default</LanguageStandard_C>
      <ObjectFileName>$(IntDir)</ObjectFileName>
    </ClCompile>
    <CustomBuild>
