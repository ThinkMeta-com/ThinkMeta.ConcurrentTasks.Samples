      <Command>"$(TM_Nasm)" -fwin64 -DWIN64 -D__x86_64__ -I"$(JpegDir)simd\nasm\\" -I"$(JpegDir)simd\x86_64\\" "%(FullPath)" -o"$(IntDir)%(Filename).asm.obj"</Command>
