// Version resource of ctLame.exe

#include <winver.h>

#include "../ThinkMeta.ConcurrentTasks.Samples.ctLame.Encoder/ctLameVersion.h"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     CTLAME_VERSION_MAJOR, CTLAME_VERSION_MINOR, 0, 0
PRODUCTVERSION  CTLAME_VERSION_MAJOR, CTLAME_VERSION_MINOR, 0, 0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
FILEFLAGS       VS_FF_DEBUG
#else
FILEFLAGS       0
#endif
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "ThinkMeta Software GmbH"
            VALUE "FileDescription", "ctLame MP3 encoder (parallel port of LAME 4.0)"
            VALUE "FileVersion", CTLAME_VERSION_STRING
            VALUE "InternalName", "ctLame"
            VALUE "LegalCopyright", CTLAME_COPYRIGHT "; LAME: Copyright (c) 1999-2011 The LAME Project; LGPL"
            VALUE "OriginalFilename", "ctLame.exe"
            VALUE "ProductName", "ctLame"
            VALUE "ProductVersion", CTLAME_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
